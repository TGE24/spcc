# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings -> API in the Supabase dashboard). See SETUP.md for the full walkthrough.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Mailtrap (Email Sending — production SMTP) for the Mass booking confirmation
# and status-update emails. See SETUP.md step 7 for where to get these.
MAILTRAP_HOST=live.smtp.mailtrap.io
MAILTRAP_PORT=587
MAILTRAP_USERNAME=your-mailtrap-smtp-username
MAILTRAP_PASSWORD=your-mailtrap-smtp-password
MAILTRAP_FROM_EMAIL=noreply@yourparishdomain.org
MAILTRAP_FROM_NAME=Saint Patrick Parish
