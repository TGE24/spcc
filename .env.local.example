# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings -> API in the Supabase dashboard). See SETUP.md for the full walkthrough.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Resend for the Mass booking confirmation and status-update emails.
# See SETUP.md step 7 for where to get these.
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=noreply@yourparishdomain.org
RESEND_FROM_NAME=Saint Patrick Parish
